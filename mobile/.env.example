# Copy to `.env` to override the API the app talks to.
# Omit the file entirely to use the deployed test API
# (https://dmrc-rest-api.vercel.app/api/v1).
#
# Note the /api/v1 suffix — all routes live under that prefix.

# Local backend, iOS simulator / web:
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Local backend, Android emulator (10.0.2.2 maps to the host loopback):
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000/api/v1

# Local backend, physical device on the same network:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:8000/api/v1
