{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "github-release": {
      "environment": "production",
      "env": {
        "NODE_ENV": "production",
        "ANDROID_RELEASE_ABI": "arm64-v8a"
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      }
    },
    "github-release-armeabi-v7a": {
      "extends": "github-release",
      "env": {
        "ANDROID_RELEASE_ABI": "armeabi-v7a"
      }
    }
  }
}
