{
  "name": "delhi-metro-app",
  "version": "1.5.1",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "EXPO_NO_DOTENV=1 expo export --platform web --output-dir dist",
    "preview:web": "wrangler dev",
    "deploy:web": "bun run build:web && wrangler deploy"
  },
  "dependencies": {
