{
  "expo": {
    "name": "Delhi NCR Metro",
    "slug": "delhi-metro",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "codes.tashif.delhimetro"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#0A3D7A"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "codes.tashif.delhimetro",
      "versionCode": 24
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Delhi NCR Metro",
      "shortName": "NCR Metro",
      "description": "Journey planner, fares, timings, and network maps for Delhi Metro and Noida Metro.",
      "lang": "en",
      "themeColor": "#0A3D7A",
      "backgroundColor": "#ffffff",
      "display": "standalone"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save metro maps.",
          "granularPermissions": []
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ddb1eb79-9db9-4b54-9880-473323f60b6d"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/ddb1eb79-9db9-4b54-9880-473323f60b6d"
    }
  }
}
